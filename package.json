{
  "name": "@local/delete-session",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Permanently delete a DSH session and its session-owned data.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/norlandsoft/dsh-delete-session.git"
  },
  "exports": {
    ".": "./server.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "server.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  }
}
